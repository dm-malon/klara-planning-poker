# Supabase Realtime (Project Settings → API). Without these the app runs in
# "local demo mode": rooms sync only between tabs of the same browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# GIPHY (server-side only). Without it, memes fall back to emoji cards.
GIPHY_API_KEY=your-giphy-api-key

# Vercel only: protects /api/keepalive (Vercel Cron sends it automatically).
# CRON_SECRET=any-long-random-string
